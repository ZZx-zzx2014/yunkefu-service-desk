# 依赖与构建产物
node_modules/
.npm-cache/
npm-debug.log*
yarn-error.log*

# ============================================================
# 敏感文件 —— 绝不能提交
# ============================================================

# 环境变量（含 KEFU_SECRET 等密钥）
.env
.env.local
.env.*.local

# SQLite 数据库（含真实账号、聊天记录、工单）
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite3

# 用户上传的文件
data/uploads/*
!data/uploads/.gitkeep

# npm run lan 生成的二维码（内含本机局域网 IP）
data/lan-qr-*.png
data/lan-qr-*.svg

# ============================================================
# 编辑器 / 操作系统
# ============================================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
