# ============================================================================
# 云客客服系统 —— 环境变量示例
#
# 用法：复制为 .env 后按需修改
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# 服务启动时会自动读取本文件（零依赖实现，见 server/env.js）。
# 真实环境变量优先于 .env —— 若你已在系统里设置了同名变量，这里会被忽略。
# ============================================================================


# ---------------------------------------------------------------------------
# 一、测试模式（默认开启，适合本地 / 局域网试用）
# ---------------------------------------------------------------------------
#
#   KEFU_TEST_MODE=1 或未设置  →  测试模式
#       · 只监听 127.0.0.1，不对外暴露
#       · 只接受本机与私有网段（局域网）来源
#       · 允许「一键体验」：可免密码以演示账号进入（含管理员）
#
#   KEFU_TEST_MODE=0           →  对外服务模式
#       · 必须提供 KEFU_SECRET，否则拒绝启动
#       · 「一键体验」接口被禁用
#       · 监听 0.0.0.0（可用 HOST 覆盖）
#
# 开源项目默认以测试模式运行，避免有人误把演示环境直接暴露到公网。
# KEFU_TEST_MODE=1


# ---------------------------------------------------------------------------
# 二、对外服务模式必填：令牌签名密钥
# ---------------------------------------------------------------------------
#
# 生成一个强随机密钥：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 配置形式：
KEFU_SECRET=请替换为上面生成的随机串
#
# 说明：
#   · 该密钥用于签发登录令牌，泄露等于任何人可伪造管理员身份
#   · 未设置时：测试模式会用「进程内随机密钥」，重启后所有登录失效
#   · 生产模式（KEFU_TEST_MODE=0）未设置或使用示例值时，服务拒绝启动


# ---------------------------------------------------------------------------
# 三、监听与端口
# ---------------------------------------------------------------------------
PORT=3000
# 监听地址。测试模式默认 127.0.0.1；设为 0.0.0.0 可让手机在同一局域网访问
# （测试模式下即使放开监听，仍然只接受私有网段来源）
# HOST=0.0.0.0


# ---------------------------------------------------------------------------
# 四、其它可选配置
# ---------------------------------------------------------------------------
# 数据库文件位置（默认 data/kefu.db）
# KEFU_DB_FILE=/absolute/path/to/kefu.db

# 反向代理场景下信任 X-Forwarded-For（仅在确认代理可信、且已剥离客户端伪造头时开启）
# KEFU_TRUST_PROXY=1

# 登录 / 2FA 验证的速率限制（默认 15 与 10 次/分钟；自动化测试可调高）
# KEFU_LOGIN_RATE_LIMIT=15
# KEFU_2FA_RATE_LIMIT=10
# KEFU_2FA_ADMIN_RATE_LIMIT=10

# WebSocket 连接与在线状态调试日志
# KEFU_WS_DEBUG=1

# 启动时在终端打印可扫描的二维码
# KEFU_SHOW_QR=1
