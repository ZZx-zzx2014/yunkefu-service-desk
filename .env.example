# ============================================================================
# 云客客服系统 —— 环境变量示例
#
# 用法：复制为 .env 后按需修改
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# 服务启动时会自动读取本文件（零依赖实现，见 server/env.js）。
# 真实环境变量优先于 .env —— 若你已在系统里设置了同名变量，这里会被忽略。
#
# 模式速查：
#   npm start          → 正常模式（默认）：监听所有网卡，必须设置 KEFU_SECRET
#   npm run testmode   → 测试模式：仅本机可访问，一键体验可用，无需密钥
#   npm run start:lan  → 正常模式 + 局域网地址提示
# ============================================================================


# ---------------------------------------------------------------------------
# 一、运行模式（默认：正常模式）
# ---------------------------------------------------------------------------
#
#   KEFU_TEST_MODE 未设置或为 0  →  正常模式（默认）
#       · 监听 0.0.0.0（可用 HOST 覆盖），供局域网/公网访问
#       · 必须提供 KEFU_SECRET，否则拒绝启动
#       · 「一键体验」接口被禁用
#
#   KEFU_TEST_MODE=1            →  测试模式（或直接 npm run testmode）
#       · 只监听 127.0.0.1，且只接受本机与私有网段来源
#       · 「一键体验」可用：可免密码以演示账号进入（含管理员）
#       · 未提供 KEFU_SECRET 时用进程内随机密钥（重启后所有登录失效）
#
# KEFU_TEST_MODE=0


# ---------------------------------------------------------------------------
# 二、正常模式必填：令牌签名密钥
# ---------------------------------------------------------------------------
#
# 生成一个强随机密钥：
#   npm run new-secret
#
# 配置形式：
KEFU_SECRET=请替换为 npm run new-secret 生成的随机串
#
# 说明：
#   · 该密钥用于签发登录令牌，泄露等于任何人可伪造管理员身份
#   · 正常模式（默认）未设置或使用弱值时，服务拒绝启动
#   · 测试模式未设置时自动用「进程内随机密钥」，重启后所有登录失效


# ---------------------------------------------------------------------------
# 三、监听与端口
# ---------------------------------------------------------------------------
PORT=3000
# 监听地址。正常模式默认 0.0.0.0（局域网可访问）；测试模式默认 127.0.0.1
# HOST=0.0.0.0


# ---------------------------------------------------------------------------
# 四、其它可选配置
# ---------------------------------------------------------------------------
# 数据库文件位置（默认 data/kefu.db）
# KEFU_DB_FILE=/absolute/path/to/kefu.db

# 反向代理场景下信任 X-Forwarded-For（仅在确认代理可信、且已剥离客户端伪造头时开启）
# KEFU_TRUST_PROXY=1

# 登录 / 2FA 验证的速率限制（默认 15 与 10 次/分钟；自动化测试可调高）
# KEFU_LOGIN_RATE_LIMIT=15
# KEFU_2FA_RATE_LIMIT=10
# KEFU_2FA_ADMIN_RATE_LIMIT=10

# WebSocket 连接与在线状态调试日志
# KEFU_WS_DEBUG=1

# 启动时在终端打印可扫描的二维码
# KEFU_SHOW_QR=1
